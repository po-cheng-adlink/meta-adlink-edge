From 9a690d8b14d163ded094762e51561fa992775a73 Mon Sep 17 00:00:00 2001
From: "po.cheng" <po.cheng@adlinktech.com>
Date: Wed, 12 Feb 2025 16:33:13 +0800
Subject: [PATCH 1/5] DeviceGoSDK: SmartCTLParser: parse emmc for arm64

Signed-off-by: po.cheng <po.cheng@adlinktech.com>
---
 .../devicegosdk/DeviceGoSmartCTLParser.py     | 33 +++++++++++++------
 1 file changed, 23 insertions(+), 10 deletions(-)

diff --git a/devicegosdk/devicegosdk/DeviceGoSmartCTLParser.py b/devicegosdk/devicegosdk/DeviceGoSmartCTLParser.py
index 2fc6d45..c2877f9 100644
--- a/devicegosdk/devicegosdk/DeviceGoSmartCTLParser.py
+++ b/devicegosdk/devicegosdk/DeviceGoSmartCTLParser.py
@@ -6,6 +6,7 @@ import platform
 ASD_SATA_INTERFACE = "asd_sata"
 ASD_PCIE_INTERFACE = "asd_pcie"
 ossystem = platform.system()
+osmachine = platform.machine()
 
 
 class DeviceGoSmartCTLParser:
@@ -23,16 +24,28 @@ class DeviceGoSmartCTLParser:
                     [smartctl_exe_path] + arguments, text=True, stdout=subprocess.PIPE
                 )
             else:
-                # command = "sudo smartctl --scan"
-                command = "smartctl --scan"
-                result = subprocess.run(
-                    command,
-                    shell=True,
-                    check=True,
-                    stdout=subprocess.PIPE,
-                    stderr=subprocess.PIPE,
-                    text=True,
-                )
+                if osmachine == "x86_64" or osmachine == "amd64":
+                    # command = "sudo smartctl --scan"
+                    command = "smartctl --scan"
+                    result = subprocess.run(
+                        command,
+                        shell=True,
+                        check=True,
+                        stdout=subprocess.PIPE,
+                        stderr=subprocess.PIPE,
+                        text=True,
+                    )
+                elif osmachine == "aarch64" or osmachine == "arm64":
+                    # command = "sudo lsblk -l -n -p"
+                    command = "lsblk -l -n -p"
+                    result = subprocess.run(
+                        command,
+                        shell=True,
+                        check=True,
+                        stdout=subprocess.PIPE,
+                        stderr=subprocess.PIPE,
+                        text=True,
+                    )
 
             storages = []
             for line in result.stdout.splitlines():
-- 
